{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effectproof.dev/schemas/evidence-v0.1.json",
  "title": "Signed EffectProof evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "attestor", "authorizationDigest", "workloadBindingDigest", "observationDigests", "findings", "verdict"],
      "properties": {
        "schemaVersion": { "const": "effectproof.dev/evidence/v0.1" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "attestor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "keyId", "publicKey", "algorithm"],
          "properties": {
            "identity": { "type": "string", "minLength": 1 },
            "keyId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "publicKey": { "type": "string", "contentEncoding": "base64" },
            "algorithm": { "const": "Ed25519" }
          }
        },
        "authorizationDigest": { "$ref": "#/$defs/sha256" },
        "workloadBindingDigest": { "$ref": "#/$defs/sha256" },
        "observationDigests": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "findings": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "verdict": { "enum": ["verified", "violation", "incomplete", "unverifiable"] }
      }
    },
    "signature": { "type": "string", "contentEncoding": "base64" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
